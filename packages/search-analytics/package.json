{
  "name": "@tgbox/search-analytics",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "exports": {
    "./contracts": "./src/contracts.ts",
    ".": "./src/index.ts",
    "./client": "./src/client.ts"
  },
  "scripts": {
    "types": "wrangler types --strict-vars=false",
    "typecheck": "tsc",
    "test": "node scripts/generate-normalization.ts --check && vitest run",
    "generate:normalization": "node scripts/generate-normalization.ts && biome format --write src/character-fold.gen.ts",
    "check:normalization": "node scripts/generate-normalization.ts --check"
  },
  "dependencies": {
    "zod": "catalog:",
    "@tgbox/telegram": "workspace:*"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "catalog:",
    "@tgbox/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "wrangler": "catalog:",
    "opencc-js": "catalog:"
  }
}
