{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tgbox-ai-summary",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-22",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "preview_urls": false,
  "vars": { "AI_SUMMARY_SCOPE": "selected", "AI_SUMMARY_ENTRY_IDS": "" },
  "observability": { "enabled": true, "traces": { "enabled": true } },
  "triggers": { "crons": ["*/5 * * * *"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgbox",
      "database_id": "426a1d23-bde7-42fc-a5ab-e76b3b408df5",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tgbox-media" }],
  "ai": { "binding": "AI" },
  "queues": {
    "producers": [{ "binding": "SUMMARY_QUEUE", "queue": "tgbox-ai-summary" }],
    "consumers": [
      {
        "queue": "tgbox-ai-summary",
        "max_batch_size": 2,
        "max_concurrency": 1,
        "max_retries": 3,
        "dead_letter_queue": "tgbox-ai-summary-dlq"
      },
      { "queue": "tgbox-ai-summary-dlq", "max_batch_size": 2, "max_concurrency": 1 }
    ]
  }
}
