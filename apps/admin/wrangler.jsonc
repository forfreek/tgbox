{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tgbox-admin",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Keep the admin hostname off until Cloudflare Access is confirmed. The app also
  // rejects requests that lack an Access JWT or a valid Telegram initData signature.
  "workers_dev": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgbox",
      "database_id": "426a1d23-bde7-42fc-a5ab-e76b3b408df5",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Suggests a category when an admin adds an entry by hand; see packages/core/src/suggest.ts.
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tgbox-media" }],
  "vars": {
    // e.g. "myteam.cloudflareaccess.com"
    "CF_ACCESS_TEAM_DOMAIN": "",
    // Application Audience (AUD) tag of the Access application.
    "CF_ACCESS_AUD": "",
    // "1" skips auth, but only for requests to localhost / 127.0.0.1. Set in .dev.vars, never here.
    "ADMIN_DEV_BYPASS": "",
    "GITHUB_REPO": "forfreek/tgbox",
    "SITE_URL": "https://tgbox-web.wayoute.workers.dev",
    "R2_PUBLIC_URL": "https://pub-bd62a219bc604095a00d17b90e4cc7c4.r2.dev",
    // Public URL of the bot Worker; the admin shows `${BOT_PUBLIC_URL}/cryptopay/webhook` for @CryptoBot.
    "BOT_PUBLIC_URL": "https://tgbox-bot.wayoute.workers.dev"
  }
  // Secrets (see .dev.vars.example): BOT_TOKEN, GITHUB_DISPATCH_TOKEN, ADMIN_IDS, ADMIN_EMAILS, SETTINGS_KEY
}
