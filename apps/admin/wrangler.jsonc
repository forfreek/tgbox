{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tgbox-admin",
  "main": "@tanstack/react-start/server-entry",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Mini App hostname. workers.dev stays off, and Cloudflare Access is not placed in
  // front of this domain: Access would block Telegram initData login. Server calls
  // still require an Access JWT or valid initData (see src/server/auth.ts).
  "workers_dev": false,
  "routes": [{ "pattern": "admin.tgsearch.app", "custom_domain": true }],
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgbox",
      "database_id": "426a1d23-bde7-42fc-a5ab-e76b3b408df5",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Suggests a category when an admin adds an entry by hand; see packages/core/src/suggest.ts.
  "ai": { "binding": "AI" },
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tgbox-media" }],
  "vars": {
    // e.g. "myteam.cloudflareaccess.com"
    "CF_ACCESS_TEAM_DOMAIN": "",
    // Application Audience (AUD) tag of the Access application.
    "CF_ACCESS_AUD": "",
    // "1" skips auth, but only for requests to localhost / 127.0.0.1. Set in .dev.vars, never here.
    "ADMIN_DEV_BYPASS": "",
    "GITHUB_REPO": "forfreek/tgbox",
    "SITE_URL": "https://tgsearch.app",
    "R2_PUBLIC_URL": "https://media.tgsearch.app",
    // Public URL of the bot Worker; the admin shows `${BOT_PUBLIC_URL}/cryptopay/webhook` for @CryptoBot.
    "BOT_PUBLIC_URL": "https://bot.tgsearch.app"
  }
  // Secrets (see .dev.vars.example): BOT_TOKEN, GITHUB_DISPATCH_TOKEN, ADMIN_IDS, ADMIN_EMAILS, SETTINGS_KEY
}
