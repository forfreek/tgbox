---
interface Props {
  class?: string;
}
const { class: className } = Astro.props;
---

{/* Blue disc, white lens, orange handle. The same mark as the favicon. */}
<svg viewBox="0 0 32 32" class={className} aria-hidden="true">
  <circle cx="16" cy="16" r="15" fill="var(--primary)"></circle>
  <circle cx="13.5" cy="13.5" r="5.6" fill="none" stroke="#fff" stroke-width="3"></circle>
  <path
    d="M16.8 16.8 23.4 23.4"
    fill="none"
    stroke="var(--brand-dot)"
    stroke-width="3"
    stroke-linecap="round"
  ></path>
</svg>
