{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "tgbox-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-09-15",
  "compatibility_flags": ["nodejs_compat"],
  // Phase 1 has no custom domain. workers.dev is on unless a routes entry is present.
  "workers_dev": true,
  // Only /r/* reads it: the promo click redirect counts the click before sending the visitor on.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tgbox",
      "database_id": "426a1d23-bde7-42fc-a5ab-e76b3b408df5",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  // Banner images uploaded from the Mini App (`promos/<order id>.jpg`), the same bucket and key the
  // bot writes when a banner is bought in chat.
  "r2_buckets": [{ "binding": "MEDIA", "bucket_name": "tgbox-media" }],
  // Workers AI (free allocation): the category suggestion on the submit form, and only when the
  // keyword rules are unsure — a handful of calls a day (see packages/core/src/suggest.ts).
  "ai": { "binding": "AI" },
  "vars": {
    "R2_PUBLIC_URL": "https://pub-bd62a219bc604095a00d17b90e4cc7c4.r2.dev"
  },
  "assets": {
    // Astro writes static pages to dist/client; its build also emits dist/server/wrangler.json, which
    // `wrangler deploy` picks up via .wrangler/deploy/config.json.
    "directory": "./dist/client",
    // Public pages never hit the Worker; only dynamic API routes and the promo click redirect do.
    // /r/* costs one Worker request per click out of the 100k/day free allowance.
    "run_worker_first": ["/api/*", "/r/*"],
    "not_found_handling": "404-page"
  }
  // Secrets (see .dev.vars.example): BOT_TOKEN — Mini App initData verification only.
}
